# SWEEP ekransız bot ayarları (/etc/sweep.env). Değiştirince: sudo systemctl restart sweep-bot
TZ=Europe/Istanbul
# Ek bayraklar, ör. --every 300000 --min-vol 10000000 --votes deep
SWEEP_ARGS=--quiet
# Node bellek sınırı (MB). 1 GB'lık makinede 600, Ampere A1'de 2048.
NODE_OPTIONS=--max-old-space-size=700

# Saatlik yedek (isteğe bağlı): özel bir GitHub deposu, ör. git@github.com:denizalpkargi/sweep-canli.git
# Sunucudaki ~/.ssh/sweep_yedek anahtarının açık yarısı o depoya "Deploy key" (yazma izinli) olarak eklenmeli.
SWEEP_YEDEK_REPO=
SWEEP_YEDEK_KEY=/home/ubuntu/.ssh/sweep_yedek

# Selim / yapay zekâ masası için LLM (isteğe bağlı; yoksa bot kural masasıyla çalışır)
# LLM_PROVIDER=ollama
# LLM_URL=http://localhost:11434/api/chat
# LLM_MODEL=qwen3:8b
